{
    "name": "chat-project",
    "version": "1.0.0",
    "main": "dist/index.js",
    "scripts": {
      "start": "node dist/index.js",                // Ejecutar el servidor compilado
      "dev": "ts-node-dev src/index.ts",            // Ejecutar el servidor en modo desarrollo
      "build": "tsc"                               // Compilar el código TypeScript a JavaScript
    },
    "dependencies": {
      "express": "^4.18.2",                        // Framework web para manejar las rutas
      "body-parser": "^1.20.2",                    // Para manejar solicitudes POST
      "jsonwebtoken": "^8.5.1"                     // Para generar y verificar JWT
    },
    "devDependencies": {
      "typescript": "^5.2.2",                      // Compilador de TypeScript
      "ts-node-dev": "^2.0.0"                      // Para correr TypeScript directamente
    }
  }
  
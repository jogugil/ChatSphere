{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "jsx": "react",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "moduleResolution": "node"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ],
    "devDependencies": {
        "@tsconfig/node16": "^16.1.3",
        "@types/axios": "^0.9.36",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/react-dom": "^19.0.2",
        "@types/react-router-dom": "^5.3.3",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.2",
        "vite": "^6.0.3"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "jsonwebtoken": "^9.0.2",
        "react-router-dom": "^7.0.2",
        "uuid": "^11.0.3"
    }
}

{
  "compilerOptions": {
 
   
    "allowJs": true, // Permite que TypeScript procese archivos .js
    "checkJs": false, // Evita errores estrictos en archivos .js
    "strict": true, // Opcional: activa comprobaciones estrictas
 
 
 "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "baseUrl": "./src",
 
    "outDir": "./dist",
 
    "target": "esnext",
 
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "include": ["src/**/*" , "vite.config.ts"], 
  "exclude": ["node_modules"] 
}